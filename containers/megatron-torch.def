Bootstrap: docker
From: nvcr.io/nvidia/pytorch:25.06-py3

%files
    containers/requirements_torchtune.txt /app/requirements.txt

%post
    set -e
    set -x
    export LD_LIBRARY_PATH=$LD_LIBRARY_PATH:/usr/local/cuda-12.9/compat
    export PIP_NO_CACHE_DIR=1

    export DEBIAN_FRONTEND=noninteractive

    # Set env variables so we can compile our application
    export PATH={{ ompi_dir }}/bin:$PATH
    export LD_LIBRARY_PATH={{ ompi_dir }}/lib:$LD_LIBRARY_PATH

    # ## NCCL tests
    echo "Installing NCCL tests"
    cd /tmp
    git clone https://github.com/NVIDIA/nccl-tests.git
    cd nccl-tests
    make MPI=1 MPI_HOME={{ ompi_dir }} CUDA_HOME=/usr/local/cuda \
        NVCC_GENCODE="-gencode=arch=compute_80,code=sm_80 -gencode=arch=compute_90,code=sm_90" \
        -j$(nproc)

    export NCCL_TEST_DIR=/opt/nccl-tests/bin
    mkdir -p $NCCL_TEST_DIR

    cp /tmp/nccl-tests/build/all_reduce_perf $NCCL_TEST_DIR
    cp /tmp/nccl-tests/build/all_gather_perf $NCCL_TEST_DIR
    cp /tmp/nccl-tests/build/broadcast_perf $NCCL_TEST_DIR
    cp /tmp/nccl-tests/build/reduce_perf $NCCL_TEST_DIR
    cp /tmp/nccl-tests/build/reduce_scatter_perf $NCCL_TEST_DIR
    cp /tmp/nccl-tests/build/alltoall_perf $NCCL_TEST_DIR

    # ## Python venv
    echo "Installing Python venv"
    pip install -r /app/requirements.txt

    # ## Cleanup
    rm /app/requirements.txt
    rm -rf /tmp/nccl-tests


%environment
    export NCCL_TEST_DIR=/opt/nccl-tests/bin
 
    export LD_PRELOAD=
    export PATH="$PATH:$NCCL_TEST_DIR"
    export LD_LIBRARY_PATH=$LD_LIBRARY_PATH:/usr/local/cuda-12.9/compat

