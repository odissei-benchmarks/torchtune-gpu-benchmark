#!/bin/bash
#SBATCH --job-name=nccl-tests
#SBATCH --nodes=2
#SBATCH --ntasks-per-node=4
#SBATCH --gpus-per-node=4
#SBATCH --partition=gpu_a100
#SBATCH --time=00:30:00
#SBATCH -e logs/%x.%j.err
#SBATCH -o logs/%x.%j.out

source containers/setup_nccl_tests.sh

let WORLD_SIZE="$SLURM_GPUS_PER_NODE*$SLURM_JOB_NUM_NODES"

LOW=64M
HIGH=512M
STEP=2


# Run multiple tests to cover FSDP's communication patterns
echo "Testing All-Reduce"
mpirun -N $SLURM_GPUS_PER_NODE \
    apptainer exec \
    --env NCCL_SOCKET_IFNAME="eno" \
    --env NCCL_DEBUG="VERSION" \
    --env GPUS_PER_NODE=$SLURM_GPUS_PER_NODE \
    --env WORLD_SIZE=$WORLD_SIZE \
    --env OPAL_PREFIX=/opt/ompi \
    --nv $IMAGE \
    all_reduce_perf -b $LOW -e $HIGH -f $STEP -g $SLURM_GPUS_PER_NODE

#echo "Testing All-Gather (for weight consolidation)"
#srun apptainer exec --nv $IMAGE \
#    all_gather_perf -b $LOW -e $HIGH -f $STEP -g $N_GPUS
#
#echo "Testing Reduce-Scatter (for gradient partitioning)"
#srun apptainer exec --nv $IMAGE \
#    reduce_scatter_perf -b $LOW -e $HIGH -f $STEP -g $N_GPUS

