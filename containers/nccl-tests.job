#!/bin/bash
#SBATCH --job-name=nccl-tests
#SBATCH --nodes=2
#SBATCH --ntasks-per-node=4
#SBATCH --gpus-per-node=4
#SBATCH --partition=gpu_a100
#SBATCH --time=00:30:00
#SBATCH -e logs/%x.%j.err
#SBATCH -o logs/%x.%j.out

# Check with cat logs/nccl-tests.jobid.out | grep -e  "bandwidth" -e "Testing"

source containers/setup_nccl_tests.sh

#let WORLD_SIZE="$SLURM_GPUS_PER_NODE*$SLURM_JOB_NUM_NODES"
NCCL_DEBUG="INFO"
NCCL_SOCKET="eno"

LOW=64M
HIGH=512M
STEP=2

echo "Infiniband speed:"
ibstat | grep -A 3 -B 3 "Rate"

echo "GPUS per node: $SLURM_GPUS_PER_NODE"

MLX_LIBS=find /usr/lib64 -name "libmlx*.so" -o -name "libibverbs.so*" | xargs -I{} dirname {} | sort | uniq | paste -sd "," -
IB_LIBS=find /usr/lib64 -path "*/libibverbs/*" | xargs -I{} dirname {} | sort | uniq | paste -sd "," -


# Run multiple tests to cover FSDP's communication patterns
echo "Testing All-Reduce"
mpirun -N 4 \
    apptainer exec \
    --bind $MLX_LIBS,$IB_LIBS \
    --env NCCL_SOCKET_IFNAME=$NCCL_SOCKET \
    --env NCCL_DEBUG=$NCCL_DEBUG \
    --env OPAL_PREFIX=/opt/ompi \
    --env TRITON_LIBCUDA_PATH=/usr/local/cuda-12.9/compat/lib.real/lib/libcuda.so.1 \
    --nv $IMAGE \
    all_reduce_perf -b $LOW -e $HIGH -f $STEP -g 1


