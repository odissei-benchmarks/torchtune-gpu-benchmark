#!/bin/bash
#SBATCH --job-name=run-nccl-tests
#SBATCH --nodes=2
#SBATCH --ntasks-per-node=4
#SBATCH --gpus-per-node=4
#SBATCH --partition=gpu_h100
#SBATCH --time=00:30:00
#SBATCH -e logs/%x.%j.err
#SBATCH -o logs/%x.%j.out

source containers/setup_nccl_tests.sh

export NCCL_SOCKET_IFNAME="eno2np0"

LOW=64M
HIGH=512M
STEP=2


# Run multiple tests to cover FSDP's communication patterns
echo "Testing All-Reduce (for gradient synchronization)"
mpirun -np 8  \
    apptainer exec \
    --env GPUS_PER_NODE=4 \
    --env WORLD_SIZE=8 \
    --nv $IMAGE \
    all_reduce_perf -b $LOW -e $HIGH -f $STEP -g 1

#echo "Testing All-Gather (for weight consolidation)"
#srun apptainer exec --nv $IMAGE \
#    all_gather_perf -b $LOW -e $HIGH -f $STEP -g $N_GPUS
